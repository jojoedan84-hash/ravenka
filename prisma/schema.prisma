generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  active    Boolean   @default(true)
  sortOrder Int       @default(0)
  products  Product[]
}

model Product {
  id          String           @id @default(cuid())
  categoryId  String?
  category    Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  slug        String           @unique
  name        String
  sku         String           @unique
  description String
  basePrice   Int
  compareAt   Int?
  weight      Int              @default(500)
  thumbnail   String
  active      Boolean          @default(true)
  featured    Boolean          @default(false)
  seoTitle    String?
  seoDesc     String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  images      ProductImage[]
  variants    ProductVariant[]
  orderItems  OrderItem[]
  flashItems  FlashSaleItem[]
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int     @default(0)
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String      @unique
  size       String?
  color      String?
  price      Int?
  stock      Int         @default(0)
  weight     Int?
  active     Boolean     @default(true)
  orderItems OrderItem[]
}

model Voucher {
  id           String   @id @default(cuid())
  code         String   @unique
  type         String
  value        Int
  minPurchase  Int      @default(0)
  maxDiscount  Int?
  quota        Int?
  used         Int      @default(0)
  startsAt     DateTime
  endsAt       DateTime
  active       Boolean  @default(true)
}

model FlashSale {
  id        String          @id @default(cuid())
  name      String
  startsAt  DateTime
  endsAt    DateTime
  active    Boolean         @default(true)
  items     FlashSaleItem[]
}

model FlashSaleItem {
  id          String    @id @default(cuid())
  flashSaleId String
  productId   String
  price       Int
  stockLimit  Int?
  sold        Int       @default(0)
  flashSale   FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id            String      @id @default(cuid())
  orderNo       String      @unique
  customerName  String
  email         String?
  phone         String
  address       String
  destinationId String?
  courier       String?
  service       String?
  shippingCost  Int         @default(0)
  subtotal      Int
  discount      Int         @default(0)
  total         Int
  voucherCode   String?
  status        String      @default("PENDING")
  paymentStatus String      @default("PENDING")
  paymentToken  String?
  paymentUrl    String?
  midtransRaw   String?
  awb           String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]
}

model OrderItem {
  id        String         @id @default(cuid())
  orderId   String
  productId String
  variantId String?
  name      String
  sku       String
  size      String?
  color     String?
  price     Int
  qty       Int
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
}

model SiteSetting {
  id             String   @id @default("main")
  brandName      String   @default("Ravenka")
  tagline        String   @default("Everyday style, made for you.")
  logoUrl        String   @default("/logo-ravenka.jpg")
  heroTitle      String   @default("BUILT FOR YOUR EVERYDAY")
  heroText       String   @default("Premium everyday fashion dengan karakter Ravenka.")
  heroImage      String   @default("https://images.unsplash.com/photo-1483985988355-763728e1935b")
  primaryCta     String   @default("Belanja Sekarang")
  primaryHref    String   @default("/shop")
  seoTitle       String   @default("Ravenka — Fashion Indonesia")
  seoDesc        String   @default("Fashion Ravenka untuk gaya sehari-hari.")
  freeShippingMin Int     @default(500000)
  updatedAt      DateTime @updatedAt
}
